# Password untuk masuk ke halaman Dashboard Admin (/admin)
# Ganti dengan password rahasia Anda di Vercel Environment Variables!
ADMIN_PASSWORD=malta20584241

# Secret untuk tanda tangan sesi login Admin
AUTH_SECRET=malta-tawangsari-trowulan-secret-key-2026

# ----------------------------------------------------------
# KONEKSI DATABASE SUPABASE (POSTGRESQL CLOUD)
# Ambil dari: Supabase Dashboard -> Project Settings -> API
# ----------------------------------------------------------
# Project URL (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# API Keys (Pilih salah satu atau isi keduanya):
# - service_role secret key (Akses penuh admin backend - DIREKOMENDASIKAN)
# - anon public key (Kunci publik frontend)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
